{
  "name": "solidary-links",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w apps/site run dev -- --strictPort",
    "dev:no-netlify": "npm -w apps/site run dev -- --strictPort",
    "build": "npm -w packages/protocol run build && npm -w apps/site run build",
    "lint": "npm -w apps/site run lint",
    "functions:supabase:bundle-template": "node ./scripts/generate-github-create-repo-template-bundle.mjs",
    "functions:supabase:bundle-index-template": "node ./scripts/generate-index-create-template-bundle.mjs",
    "functions:supabase:bundle-index-bootstrap": "node ./scripts/generate-index-bootstrap-sql.mjs",
    "functions:supabase:deploy:prod": "node ./scripts/deploy-supabase-functions.mjs",
    "netlify:dev": "netlify dev",
    "netlify:clean": "rm -rf .netlify apps/site/.netlify apps/site/apps"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.7.15"
  }
}
